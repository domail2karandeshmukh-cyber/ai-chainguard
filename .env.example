# Copy to .env and adjust. This file contains NO secrets.

# Workspace root: data/, artifacts/, keys/, results/ and the SQLite index live here.
CHAINGUARD_HOME=.

# Optional: alternative policy file (defaults to config/policy.yaml in the repo).
# CHAINGUARD_POLICY=config/policy.yaml

# Domain used to build signer identities, e.g. data_steward@chainguard.local
CHAINGUARD_IDENTITY_DOMAIN=chainguard.local

# Optional passphrase used to encrypt private key files at rest.
# LIMIT OF THIS VERSION: production would keep keys in an HSM/KMS, not in files.
# CHAINGUARD_KEY_PASSPHRASE=change-me

# CI only: a private key can be injected as PEM text instead of a file, e.g.
# CHAINGUARD_KEY_TRAINING_PIPELINE="-----BEGIN PRIVATE KEY-----..."

# Dashboard -> API
CHAINGUARD_API_URL=http://localhost:8000

# Enables the /demo endpoints that tamper with files on purpose (for live demos only).
CHAINGUARD_DEMO_MODE=1
